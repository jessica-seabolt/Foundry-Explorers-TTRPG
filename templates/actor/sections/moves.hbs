<section class="tab standard-form {{tabs.moves.cssClass}}" data-group="primary" data-tab="moves">
  <div class="action-buttons">
    <button type="button" data-action="basicAttack"><i class="fa-solid fa-hand-fist"></i> {{localize "SYSTEM.Actions.BasicAttack"}}</button>
    <button type="button" data-action="guard" class="{{#if isGuarding}}active{{/if}}" data-tooltip="SYSTEM.Actions.GuardHint"><i class="fa-solid fa-shield"></i> {{localize "SYSTEM.Actions.Guard"}}</button>
  </div>
  {{#if moves}}
  <div class="move-grid scrollable">
    {{#each moves as |move id|}}
    {{#with ..}}
    <fieldset class="move-block">
      <legend>{{move.name}}</legend>
      <div class="move-block-sections">
        <p>{{localize (lookup typesRecord move.system.type)}} / <!--
        -->{{localize (lookup categories move.system.category)}}<!--
        -->{{#if move.system.power}}, {{localize "SYSTEM.Models.Move.FIELDS.power.label"}}&nbsp;{{move.system.power}}{{/if}}</p>
        <p>{{#if move.system.description}}{{move.system.description}}{{/if}}</p>
        <p>
          Effects:
        {{#each move.system.effects as |effect|}}
        {{#if (equals effect.triggerType "hit")}}
          {{#each effect.appliedEffects as |apply|}}
          {{#with ../..}}
            {{localize (lookup effects apply.effect)}}
            {{#if apply.effectCount}}
              ({{apply.effectCount}})
            {{/if}}
            {{#if apply.affectsUser}}
              (User)
            {{/if}}
          {{/with}}
          {{/each}}
        {{/if}}
        {{/each}}
        </p>
        <div class="move-buttons">
          <button type="button" class="draggable" data-item-id="{{move.id}}" data-action="rollMoveDie" data-id="{{move.id}}">{{moveDie move}}</button>
          <button type="button" data-action="removeItem" data-id="{{move.id}}" class="icon fa-solid fa-trash"></button>
          <p><input type="number" data-name="ppLeft" data-id="{{move.id}}" value="{{move.system.ppLeft}}" class="pp-left" min="0" max="{{move.system.pp}}"></input> / {{move.system.pp}} PP</p>
        </div>
      </div>
    </fieldset>
    {{/with}}
    {{/each}}
  </div>
  {{else}}
  <div class="move-help">
    Drag a move onto the character sheet to import it!
  </div>
  {{/if}}
</section>