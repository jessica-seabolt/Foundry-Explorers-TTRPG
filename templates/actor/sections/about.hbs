<section class="tab standard-form {{tabs.about.cssClass}}" data-group="primary" data-tab="about">
  <div class="about">
    {{formGroup systemFields.type1 value=document.system.type1 options=types localize=true}}
    {{formGroup systemFields.type2 value=document.system.type2 options=types localize=true}}
    {{formGroup systemFields.species value=document.system.species}}
    {{formGroup systemFields.size value=document.system.size options=sizes localize=true}}
    {{#if isPlayerSheet}}
    <div class="form-group">
      <label>{{localize "SYSTEM.Models.Player.FIELDS.nature.label"}}</label>
      <div class="form-fields">
        <input type="text" name="system.nature" value="{{document.system.nature}}" list="explorers-natures">
        {{#if auraHex}}<span class="aura-swatch" style="background: {{auraHex}}" data-tooltip="{{document.system.auraColor}}"></span>{{/if}}
      </div>
    </div>
    <datalist id="explorers-natures">{{#each natureOptions as |nature|}}<option value="{{nature}}"></option>{{/each}}</datalist>
    {{#unless natureAura}}{{formGroup systemFields.aura value=document.system.aura localize=true}}{{/unless}}
    {{formGroup systemFields.class value=document.system.class options=classes localize=true}}
    {{#if classSummary}}<p class="hint class-summary">{{classSummary}}</p>{{/if}}
    {{formGroup systemFields.specialization value=document.system.specialization options=specializations localize=true}}
    {{formGroup systemFields.level value=document.system.level localize=true}}
    {{formGroup systemFields.origin value=document.system.origin localize=true}}
    {{/if}}
  </div>
  <fieldset class="held-item">
    <legend>{{localize "SYSTEM.Models.Character.FIELDS.heldItem.label"}}</legend>
    {{#if heldItem}}
    <div class="held-item-card">
      <img src="{{heldItem.img}}" alt="">
      <div>
        <a data-action="openItem" data-id="{{heldItem.id}}"><strong>{{heldItem.name}}</strong></a>
        <p>{{heldItem.description}}</p>
      </div>
      <div class="item-buttons">
        {{#if heldItem.canUse}}<button type="button" data-action="useItem" data-id="{{heldItem.id}}" class="icon fa-solid fa-hand-sparkles" data-tooltip="SYSTEM.Items.Use"></button>{{/if}}
        {{#if heldItem.canThrow}}<button type="button" data-action="throwItem" data-id="{{heldItem.id}}" class="icon fa-solid fa-baseball" data-tooltip="SYSTEM.Items.Throw"></button>{{/if}}
        {{#if team}}<button type="button" data-action="returnItem" data-id="{{heldItem.id}}" class="icon fa-solid fa-sack" data-tooltip="SYSTEM.Items.Return"></button>{{/if}}
        <button type="button" data-action="removeItem" data-id="{{heldItem.id}}" class="icon fa-solid fa-trash" data-tooltip="SYSTEM.Items.Discard"></button>
      </div>
    </div>
    {{else}}
    <p class="hint">{{localize "SYSTEM.Items.NoHeldItem"}}</p>
    {{/if}}
    {{#if team}}<p class="hint">{{localize "SYSTEM.Team.SharedBag"}} <a data-action="openTeam">{{team.name}}</a> ({{team.system.bagCount}} / {{team.system.capacity}})</p>{{/if}}
    {{#if looseItems.length}}
    <div class="loose-items">
      <p class="hint">{{localize "SYSTEM.Items.LooseItems"}}</p>
      {{#each looseItems as |item|}}<span class="condition-chip"><img src="{{item.img}}" alt="">{{item.name}}</span>{{/each}}
      {{#if team}}<button type="button" data-action="moveLooseItems"><i class="fa-solid fa-sack"></i> {{localize "SYSTEM.Items.MoveToBag"}}</button>{{/if}}
    </div>
    {{/if}}
  </fieldset>
  {{formGroup systemFields.blurbText value=document.system.blurbText elementType="textarea" classes="blurb blurb-small"}}
</section>