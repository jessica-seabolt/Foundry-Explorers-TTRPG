<div class="colored-boxes character-header">
  <div class="center">
    <img src="{{document.img}}" title="{{document.name}}" style="cursor: pointer;"
    height="70" width="70" class="edit-avatar" data-action="editImage" data-edit="img" />
  </div>
  <div class="center">
    <input type="text" name="name" value="{{document.name}}" class="character-name">
  </div>
  <div class="center">
    <div class="center-row">
      <label>{{localize "SYSTEM.Models.Character.FIELDS.hp.label"}}</label>
      <div class="hp-total">
        {{formGroup systemFields.hp.fields.raw value=document.system.hp.raw type="number" max=document.system.hp.max}}
        <p>/</p>
        <div class="form-group slim inline">
          <input type="number" value="{{document.system.hp.max}}" disabled>
        </div>
      </div>
    </div>
    {{formGroup systemFields.poke value=document.system.poke classes="slim inline center-row"}}
  </div>
  <div class="status-strip">
    <div class="condition-chips">
      {{#if heldItem}}<span class="condition-chip held-chip" data-tooltip="{{heldItem.description}}"><img src="{{heldItem.img}}" alt="">{{heldItem.name}}</span>{{/if}}
      {{#if belly}}<span class="condition-chip belly-chip {{#if belly.hungry}}hungry{{/if}}" data-tooltip="SYSTEM.Belly.Hint"><i class="fa-solid fa-utensils"></i> {{belly.label}}</span>{{/if}}
      {{#each statChips as |chip|}}
      <span class="condition-chip stat-chip {{#if chip.up}}up{{else}}down{{/if}}">{{chip.label}} {{chip.value}}</span>
      {{/each}}
      {{#each conditionChips as |chip|}}
      <span class="condition-chip" data-effect-id="{{chip.id}}" data-tooltip="{{chip.tooltip}}">
        <img src="{{chip.img}}" alt="">{{chip.name}}{{#if chip.detail}} <em>({{chip.detail}})</em>{{/if}}
      </span>
      {{else}}
      {{#unless statChips.length}}<span class="no-conditions">{{localize "SYSTEM.Misc.NoConditions"}}</span>{{/unless}}
      {{/each}}
    </div>
    <div class="sheet-utilities">
      <button type="button" class="icon fa-solid fa-bed" data-action="rest" data-tooltip="SYSTEM.Actions.RestHint" aria-label="{{localize "SYSTEM.Actions.Rest"}}"></button>
      <button type="button" class="icon fa-solid fa-stairs" data-action="newFloor" data-tooltip="SYSTEM.Actions.NewFloorHint" aria-label="{{localize "SYSTEM.Actions.NewFloor"}}"></button>
    </div>
  </div>
</div>