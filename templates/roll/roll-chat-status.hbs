<div>
  <div class="dice-roll" data-action="expandRoll">
    {{#if flavor}}
    <div class="dice-flavor">{{flavor}}</div>
    {{/if}}
    <div class="dice-result">
      <div class="dice-formula">{{formula}}</div>
      {{{tooltip}}}
      <h4 class="dice-total">{{total}}</h4>
    </div>
  </div>
  {{#if effectNames}}<p class="status-effects">{{effectNames}}</p>{{/if}}
  {{#if resistPermission}}
    <button class="resist-button" type="button">{{localize "SYSTEM.Automation.ResistButton"}} ({{localize resistText}})</button>
  {{/if}}
</div>
