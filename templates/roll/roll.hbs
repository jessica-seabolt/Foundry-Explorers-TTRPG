<section class="standard-form">
  <div class="roll-options">
    <label>DC</label><input type="number" data-name="dc" step="1" min="0">
    <label>Extra Die</label><input type="number" data-name="extraDie" step="1">
    <label>Extra Modifier</label><input type="number" data-name="extraModifier" step="1">
    <label>Multiplier</label><input type="number" data-name="multiplier">
    <label>Advantage</label>
    <select data-name="advantage">
      {{#if isMove}}<option selected value="">Default</option>{{/if}}
      {{#each advantage as |advOption advValue|}}
      {{#with ..}}
        <option {{#if (equals dialogState.advantage advValue)}}selected{{/if}} value={{advValue}}>{{localize advOption}}</option>
      {{/with}}
      {{/each}}
    </select>
    <label>High Crit. Ratio</label><input type="checkbox" data-name="highCrit">
    {{#if isMove}}
    <label>Type Matchup</label>
    <select data-name="typeMatchup">
      <option selected value="">Default</option>
      {{#each typeMatchups as |typeMatchup matchupValue|}}
        <option value={{matchupValue}}>{{localize typeMatchup}}</option>
      {{/each}}
    </select>
    {{/if}}
  </div>
  <div class="roll-types">
    {{#if isMove}}
      {{#if hasPower}}<button data-action="roll"><i class="icon fa-solid fa-dice-d6"></i>Power</button>{{/if}}
      {{#if (inSet triggers "hit")}}<button data-action="rollStatus"><i class="icon fa-solid fa-dice-d6"></i>Status</button>{{/if}}
    {{else}}
      <button data-action="roll"><i class="icon fa-solid fa-dice-d6"></i>Roll</button>
    {{/if}}

  </div>
  <div class="roll-mode-buttons split-button">
    <button type="button" class="{{#if (equals messageMode "publicroll")}}selected{{/if}} roll-btn ui-control icon fa-solid fa-globe" data-action="setMessageMode" data-messagemode="publicroll" data-tooltip="CHAT.RollPublic">
    <button type="button" class="{{#if (equals messageMode "gmroll")}}selected{{/if}} roll-btn ui-control icon fa-solid fa-user-secret" data-action="setMessageMode" data-messagemode="gmroll" data-tooltip="CHAT.RollPrivate">
    <button type="button" class="{{#if (equals messageMode "blindroll")}}selected{{/if}} roll-btn ui-control icon fa-solid fa-eye-slash" data-action="setMessageMode" data-messagemode="blindroll" data-tooltip="CHAT.RollBlind">
    <button type="button" class="{{#if (equals messageMode "selfroll")}}selected{{/if}} roll-btn ui-control icon fa-solid fa-user" data-action="setMessageMode" data-messagemode="selfroll" data-tooltip="CHAT.RollSelf">
  </div>
</section>