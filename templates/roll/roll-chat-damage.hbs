<div>
  <div class="dice-roll" data-action="expandRoll">
    {{#if flavor}}
    <div class="dice-flavor">{{flavor}}</div>
    {{/if}}
    <div class="dice-result">
      <div class="dice-formula">{{formula}}</div>
      {{{tooltip}}}
      <h4 class="dice-total">{{total}}</h4>
    </div>
  </div>
  {{#if damagePermission}}
    {{#if isHealing}}
    <button class="damage-button" type="button">{{localize "SYSTEM.Automation.HealButton"}}</button>
    {{else}}
    <button class="damage-button" type="button">{{localize "SYSTEM.Automation.DamageButton"}} ({{localize resistText}})</button>
    {{/if}}
  {{/if}}
</div>
