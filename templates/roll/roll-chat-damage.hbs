<div>
  <div class="dice-roll" data-action="expandRoll">
    {{#if flavor}}
    <div class="dice-flavor">{{flavor}}</div>
    {{/if}}
    <div class="dice-result">
      <div class="dice-formula">{{formula}}</div>
      {{{tooltip}}}
      <h4 class="dice-total">{{total}}</h4>
    </div>
  </div>
  {{#if damagePermission}}
    <button class="damage-button" data-resist="{{resistAbility}}" data-damage="{{damage}}" data-targetid="{{targetId}}">Damage ({{localize resistText}})</button>
  {{/if}}
</div>
