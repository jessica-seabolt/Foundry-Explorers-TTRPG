{
  "id": "explorers",
  "title": "Explorers! a TTRPG",
  "description": "A tabletop roleplaying game for explorers",
  "version": "1.6.6",
  "url": "https://github.com/25Pi25/Foundry-Explorers-TTRPG",
  "manifest": "https://raw.githubusercontent.com/25Pi25/Foundry-Explorers-TTRPG/main/system.json",
  "download": "https://github.com/25Pi25/Foundry-Explorers-TTRPG/releases/download/v1.6.6/explorers.zip",
  "compatibility": {
    "minimum": 13,
    "verified": 13
  },
  "authors": [
    {
      "name": "sec",
      "discord": "25pi25"
    }
  ],
  "esmodules": ["explorers.mjs"],
  "styles": ["explorers.css"],
  "packs": [
    {
      "name": "moves",
      "label": "COMPENDIUMS.Moves",
      "path": "packs/moves",
      "type": "Item",
      "banner": "systems/explorers/assets/banners/moves.webp"
    },
    {
      "name": "items",
      "label": "COMPENDIUMS.Items",
      "path": "packs/items",
      "type": "Item",
      "banner": "systems/explorers/assets/banners/items.webp"
    },
    {
      "name": "enemies",
      "label": "COMPENDIUMS.Enemies",
      "path": "packs/enemies",
      "type": "Actor",
      "banner": "systems/explorers/assets/banners/enemies.webp"
    },
    {
      "name": "tables",
      "label": "COMPENDIUMS.Tables",
      "path": "packs/tables",
      "type": "RollTable",
      "banner": "systems/explorers/assets/banners/tables.webp"
    }
  ],
  "packFolders": [
    {
      "name": "Core Rulebook",
      "color": "#000000",
      "packs": ["moves", "items", "enemies", "tables"]
    }
  ],
  "relationships": [],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "Character": {},
      "Player": {}
    },
    "Item": {
      "Move": { "htmlFields": ["description"] },
      "Item": { "htmlFields": ["description"] }
    }
  },
  "socket": false,
  "initiative": "@abilities.spe.mod",
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "hp.raw"
}
